<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <Sts2Dir>F:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
        <GodotExe>D:\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64.exe</GodotExe>
        <ModDir>$(Sts2Dir)\mods\$(MSBuildProjectName)</ModDir>
        <RitsuLibDir>$(Sts2Dir)\mods\STS2-RitsuLib</RitsuLibDir>
        <RitsuLibReferenceTarget>0.111.0</RitsuLibReferenceTarget>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
        <Compile Remove="build/**/*.cs" />
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="scripts\Keywords\" />
      <Folder Include="scripts\Potions\" />
      <Folder Include="scripts\Powers\" />
      <Folder Include="scripts\Relics\" />
    </ItemGroup>

    <Import Project="$(RitsuLibDir)\RitsuLib.References.props" />
    
    <Target Name="Copy Mod" AfterTargets="PostBuildEvent">
        <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
        <MakeDir Directories="$(ModDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(ModDir)" />
    </Target>

    <Target Name="ExportPck"
            AfterTargets="Publish"
            Condition="'$(IsTimerGodotExport)' != 'true'">
        <Error Condition="!Exists('$(GodotExe)')"
               Text="Godot executable was not found at '$(GodotExe)'. Update the GodotExe property in $(MSBuildProjectFile)." />
        <Message Text="Exporting PCK to the Slay the Spire 2 mods folder..." Importance="high" />
        <MakeDir Directories="$(ModDir)" />
        <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(ModDir)\$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsTimerGodotExport=true;STSDISABLEMODREUSE=1" />
    </Target>
</Project>
